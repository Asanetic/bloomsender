                                    "wallet_name": {
                                        "type": "string",
                                        "description": "Wallet name"
                                    },
                                    "merchant_id": {
                                        "type": "string",
                                        "description": "Merchant id"
                                    },
                                    "wallet_type": {
                                        "type": "string",
                                        "description": "Wallet type"
                                    },
                                    "wallet_balance": {
                                        "type": "string",
                                        "description": "Wallet balance"
                                    },
                                    "status": {
                                        "type": "string",
                                        "description": "Status"
                                    },
                                    "created_at": {
                                        "type": "string",
                                        "description": "Created at"
                                    },
                                    "Node": {
                                        "type": "string",
                                        "description": " Octane wallets id to update "
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated successfully"
                    }
                }
            }
        }
    }
